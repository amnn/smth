    :$ -q printf '\000' (exit: 0)
    := KEEP (failed)

> [!WARNING]
> variable value contains NUL

    :$ -q printf '\000' (exit: 0)
    := -x KEEP (failed)

> [!WARNING]
> variable value contains NUL

    :$ sh -c 'printf "%s\n" "$KEEP" "$$KEEP"' (exit: 0)


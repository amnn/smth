# Use Iosevka Term SS15 with VHS's bundled Raycast Light theme.
Set Shell bash
Set FontFamily "Iosevka Term SS15"
Set FontSize 18
Set Width 1000
Set Height 620
Set Padding 12
Set Framerate 10
Set CursorBlink false
Set Theme "Raycast_Light"

#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")
basedir_win="$basedir"
exe=""
msys=""

case `uname -a` in
  *CYGWIN*|*MINGW*|*MSYS*)
    if command -v cygpath > /dev/null 2>&1; then
      basedir_win=`cygpath -w "$basedir"`
    fi
    exe=".exe"
    msys="true"
  ;;
  *WSL2*)
    if command -v wslpath > /dev/null 2>&1; then
      basedir_win="$(wslpath -w "$basedir" 2> /dev/null)"
      if [ $? -ne 0 ] || [ -z "$basedir_win" ]; then
        basedir_win="$basedir"
      else
        exe=".exe"
      fi
    fi
  ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/ashokmenon/Code/smth/node_modules/.pnpm/@earendil-works+pi-coding-agent@0.84.1_ws@8.21.2_zod@4.4.3/node_modules/@earendil-works/pi-coding-agent/node_modules:/Users/ashokmenon/Code/smth/node_modules/.pnpm/@earendil-works+pi-coding-agent@0.84.1_ws@8.21.2_zod@4.4.3/node_modules:/Users/ashokmenon/Code/smth/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/ashokmenon/Code/smth/node_modules/.pnpm/@earendil-works+pi-coding-agent@0.84.1_ws@8.21.2_zod@4.4.3/node_modules/@earendil-works/pi-coding-agent/node_modules:/Users/ashokmenon/Code/smth/node_modules/.pnpm/@earendil-works+pi-coding-agent@0.84.1_ws@8.21.2_zod@4.4.3/node_modules:/Users/ashokmenon/Code/smth/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../@earendil-works/pi-coding-agent/dist/cli.js" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@earendil-works/pi-coding-agent/dist/cli.js" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../@earendil-works/pi-coding-agent/dist/cli.js" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../@earendil-works/pi-coding-agent/dist/cli.js" "$@"
else
  exec node  "$basedir/../@earendil-works/pi-coding-agent/dist/cli.js" "$@"
fi
